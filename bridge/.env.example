# Must match BRIDGE_API_TOKEN in the server's .env/Render environment.
BRIDGE_API_TOKEN="replace-with-the-same-long-random-secret"
# Local example: http://localhost:4173. Use your deployed Render URL remotely.
NEXUS_BRIDGE_URL="http://localhost:4173"
NEXUS_BRIDGE_POLL_SECONDS="3"
# Optional if Xournal++ is not available on PATH or a standard install path.
# XOURNALPP_EXE="C:\\Program Files\\Xournal++\\bin\\xournalpp.exe"
# Optional. Defaults to C:\TempXournal.
# XOURNAL_TEMP_DIR="C:\\TempXournal"
